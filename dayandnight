local Lighting = game:GetService("Lighting")
local Terrain = workspace:FindFirstChild("Terrain")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ============================================
-- CONFIGURACIÓN DEL CICLO DÍA/NOCHE
-- ============================================
local CYCLE_DURATION = 1200 -- segundos para un ciclo completo
local HOURS_PER_SECOND = 24 / CYCLE_DURATION

-- Configuración de iluminación para día y noche
local DAY_BRIGHTNESS = 2
local NIGHT_BRIGHTNESS = 0.2

local DAY_AMBIENT = Color3.fromRGB(128, 128, 128)
local NIGHT_AMBIENT = Color3.fromRGB(30, 30, 50)

local DAY_OUTDOOR_AMBIENT = Color3.fromRGB(128, 128, 128)
local NIGHT_OUTDOOR_AMBIENT = Color3.fromRGB(30, 30, 50)

local DAY_FOG_COLOR = Color3.fromRGB(192, 192, 192)
local NIGHT_FOG_COLOR = Color3.fromRGB(15, 15, 30)

local DAY_COLOR_SHIFT_TOP = Color3.fromRGB(215, 210, 200)
local NIGHT_COLOR_SHIFT_TOP = Color3.fromRGB(30, 40, 80)

local DAY_COLOR_SHIFT_BOTTOM = Color3.fromRGB(170, 160, 140)
local NIGHT_COLOR_SHIFT_BOTTOM = Color3.fromRGB(10, 10, 20)

-- ============================================
-- BASE DE DATOS DE EVENTOS NOCTURNOS
-- ============================================
-- Para agregar un nuevo evento, copia uno existente y cambia los valores.
-- La suma de probabilidades no debe superar 1.0
-- (el porcentaje restante = noche normal sin evento).
-- El multiplicador es accesible desde ReplicatedStorage.NightEvents.Multiplier

local NIGHT_EVENTS = {
